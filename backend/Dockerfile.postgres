FROM node:20-alpine

WORKDIR /app
COPY package*.json ./
COPY prisma-postgres ./prisma
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npx prisma generate --schema=prisma/schema.prisma && npm run build

EXPOSE 4000
CMD ["sh", "-c", "node dist/scripts/deploy-migrations.js && npm run seed:google-config:docker && node dist/server.js"]
